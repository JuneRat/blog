{
  "name": "blog-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "build:plugins": "node ../../scripts/build-markdown-enhance.mjs",
    "check:plugins": "node ../../scripts/build-markdown-enhance.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "^5.103.2",
    "antd": "6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "katex": "0.18.10",
    "mermaid": "12.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
