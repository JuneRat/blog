# 复制为 .env 并按需修改；当前服务不自动加载该文件，供 shell/工具参考。

# PostgreSQL 连接（scripts/dev-db.sh 启动的本地实例）
DATABASE_URL=postgres://blog:blog@127.0.0.1:5432/blog

# serve 监听地址（--addr 参数优先）
BLOG_BIND=127.0.0.1:8080

# 主题与迁移目录（相对仓库根运行时生效）
BLOG_THEME_DIR=themes/default
BLOG_MIGRATIONS_DIR=migrations/postgres

# 站点信息（回退值：数据库 settings.site 未配置时才生效；后台保存后由数据库接管）
BLOG_SITE_TITLE=Sun's Blog
BLOG_SITE_DESCRIPTION=一个 Rust 博客

# 对外可达基础 URL：OAuth 回调 redirect_uri、canonical、RSS 与 sitemap 的绝对链接
# 都取自它（绝不用请求的 Host 头）。装配期校验：必须是绝对 http/https、主机非空、
# 不带用户名/密码、不带查询与片段，且**不带路径前缀**；非法值直接启动失败。
# 生产环境务必设为真实域名，例如 https://blog.example.com。
# 注意：https://example.com/blog 这类子路径部署当前不支持——路由与主题链接都在
# 域名根下。建议使用独立域名，并在对外域名根路径部署，例如 https://blog.example.com。
# 仅由反向代理改写入站路径无法解决根相对链接问题，不代表支持对外部署在 /blog。
# BLOG_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 评论与业务审计来源 IP：逗号分隔的精确代理 IP，仅这些 socket 对端可提供 X-Forwarded-For。
# 不支持 CIDR；留空时仅记录 socket 对端，不信任转发头。
# BLOG_TRUSTED_PROXIES=127.0.0.1,::1

# 后台 SPA 构建产物目录（/admin/）；目录不存在时不注册该路由
# 开发方式见 docs/development.md「后台 SPA 联调」。
BLOG_ADMIN_DIST=apps/admin/dist

# 媒体库文件根目录（暂存与正式对象都在它下面）。
# 与数据库一起构成恢复单元：备份必须同时覆盖数据库与这个目录
# （docs/operations-and-recovery.md），默认落在仓库内需自行排除或改为外部路径。
BLOG_MEDIA_DIR=data/media

# 保留期任务专用连接；不回退到 DATABASE_URL，不应注入 HTTP 服务。
# 角色授权见 scripts/database-roles.sql，凭据由部署环境独立提供。
# BLOG_MAINTENANCE_DATABASE_URL=postgres://blog_maintenance:change-me@127.0.0.1:5432/blog

# 恢复核验：只允许 loopback 监听，停用自动预约发布。
# 恢复库带数据库隔离标记，核验后使用 recovery.py release 解除。
# BLOG_RECOVERY_MODE=1

# 集成测试：管理连接（测试库 DSN 从它推导）；只允许 loopback 主机
# BLOG_TEST_ADMIN_URL=postgres://blog:blog@127.0.0.1:5432/postgres

# 日志过滤
RUST_LOG=info,sqlx=warn

# 认证相关
# 会话 cookie 的 Secure 属性：不设置时按 BLOG_PUBLIC_BASE_URL 的 scheme 推断
# （https:// → 加 Secure + __Host- 绑定 cookie）；TLS 终止代理等场景可显式覆盖。
# BLOG_SECURE_COOKIES=1
# oauth add-* 配置的 secret_ref 指向的环境变量（示例）
# IDP_SECRET=change-me
# GH_SECRET=change-me
