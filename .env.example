# 复制为 .env 并按需修改；当前服务不自动加载该文件，供 shell/工具参考。

# PostgreSQL 连接（scripts/dev-db.sh 启动的本地实例）
DATABASE_URL=postgres://blog:blog@127.0.0.1:5432/blog

# serve 监听地址（--addr 参数优先）
BLOG_BIND=127.0.0.1:8080

# 主题与迁移目录（相对仓库根运行时生效）
BLOG_THEME_DIR=themes/default
BLOG_MIGRATIONS_DIR=migrations/postgres

# 站点信息（M3 迁入 settings 表）
BLOG_SITE_TITLE=Sun's Blog
BLOG_SITE_DESCRIPTION=一个 Rust 博客

# 后台 SPA 构建产物目录（/admin/）；目录不存在时不注册该路由
# 开发方式见 README「后台 SPA（apps/admin）」。
BLOG_ADMIN_DIST=apps/admin/dist

# 集成测试：管理连接（测试库 DSN 从它推导）；只允许 loopback 主机
# BLOG_TEST_ADMIN_URL=postgres://blog:blog@127.0.0.1:5432/postgres

# 日志过滤
RUST_LOG=info,sqlx=warn

# OAuth 登录相关
# 对外可达基础 URL（构建回调 redirect_uri）
# BLOG_PUBLIC_BASE_URL=http://127.0.0.1:8080
# 会话 cookie 的 Secure 属性：不设置时按 BLOG_PUBLIC_BASE_URL 的 scheme 推断
# （https:// → 加 Secure + __Host- 绑定 cookie）；TLS 终止代理等场景可显式覆盖。
# BLOG_SECURE_COOKIES=1
# oauth add-* 配置的 secret_ref 指向的环境变量（示例）
# IDP_SECRET=change-me
# GH_SECRET=change-me
