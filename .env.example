# Compose 自动读取根目录 .env；本地 cargo 启动的程序仍不自动读取它。
# 运行 sh scripts/compose-init.sh 可创建 .env、补齐随机数据库密码并设置私有权限。
# Compose 只向各服务传递 compose.yaml 中明确列出的变量。完整字段见 config.example.toml。
# CLI > env > TOML > 默认值。启动参数修改后重启服务或重新执行 CLI。

# Compose 数据库初始化；已有数据卷的密码不会随这些值变化。
BLOG_POSTGRES_PASSWORD=
BLOG_OWNER_PASSWORD=
# BLOG_HTTP_HOST=127.0.0.1
# BLOG_HTTP_PORT=8080
# BLOG_METRICS_PORT=9090
# BLOG_LOG_FORMAT=json
# BLOG_IMAGE=blog:local
# BLOG_OPS_IMAGE=blog-ops:local
# BLOG_SOURCE_REVISION=

# Compose 备份：脚本自动停写、恢复原服务并记录 backups/status.json。
# 必填：age 公钥；私钥另存于部署之外，verify/restore 时以文件参数提供。
# BLOG_BACKUP_RECIPIENT=age1...
# 明文导出/解密仅暂存于 ops 的 /tmp tmpfs；按数据量及主机内存调整上限。
# BLOG_BACKUP_TMPFS_SIZE=2g
# 本地和异地分别保留最近多少份；异地失败时不清理本地旧备份。
# BLOG_BACKUP_KEEP=7
# BLOG_BACKUP_REMOTE_KEEP=30
# 可选加密异地仓库。先配置并运行 compose-backup.sh remote-init。
# RESTIC_REPOSITORY=s3:https://s3.example.com/private-backups/blog
# RESTIC_PASSWORD=replace-with-a-long-random-password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# RESTIC_PASSWORD 须在服务器以外另存；丢失它无法解密异地备份。

# 推荐由部署工具注入数据库凭据。使用首次安装向导时不要预设连接。
# DATABASE_URL=postgres://blog:blog@127.0.0.1:5432/blog
# BLOG_CONFIG_FILE=config.toml

# 一般部署参数写入 TOML；以下是对应的临时覆盖变量。
# Compose 固定 bind、配置、媒体与后台路径；主题目录允许使用容器内路径覆盖。
# BLOG_BIND=127.0.0.1:8080
# BLOG_PUBLIC_BASE_URL=https://blog.example.com
# 进程日志时区；站点显示和预约时区在后台「站点设置」中保存。
# TZ=Asia/Shanghai
# BLOG_TRUSTED_PROXIES=127.0.0.1,::1
# BLOG_SECURE_COOKIES=true
# BLOG_THEME_DIR=themes/default # Compose 使用时须为容器内路径；恢复脚本自动设置。
# BLOG_ADMIN_DIST=apps/admin/dist
# BLOG_MEDIA_DIR=data/media
# BLOG_MIGRATIONS_DIR=migrations/postgres
# RUST_LOG=info,sqlx=warn
# Native processes: opt in to a loopback-only metrics listener. Compose fixes its container bind.
# BLOG_METRICS_BIND=127.0.0.1:9090
# BLOG_RECOVERY_MODE=false

# 维护专用受限连接，不回退到 DATABASE_URL；Compose 不将其注入 HTTP 服务。
# BLOG_MAINTENANCE_DATABASE_URL=postgres://blog_maintenance:change-me@db:5432/blog

# OAuth 提供商配置由数据库管理；secret_ref 引用下面这类环境变量。
# 修改实际环境密钥后重启服务。数据库与 TOML 不保存 OAuth secret 明文。
# IDP_SECRET=change-me
# GH_SECRET=change-me

# 标题/描述由数据库管理：首次安装通过 TOML [bootstrap] 提供初始值，
# 运行期通过后台修改。

# 开发与测试工具变量，不属于应用 TOML。
# BLOG_PG_PORT=5432
# BLOG_PG_WAIT_SECONDS=60
# BLOG_TEST_ADMIN_URL=postgres://blog:blog@127.0.0.1:5432/postgres

# 连接池：所有运行/CLI 池共用参数；总连接数需计入其他进程和运维连接。
# BLOG_DB_MAX_CONNECTIONS=5
# BLOG_DB_MIN_CONNECTIONS=0
# BLOG_DB_ACQUIRE_TIMEOUT_MS=5000
# BLOG_DB_IDLE_TIMEOUT_SECS=600
# BLOG_DB_MAX_LIFETIME_SECS=1800
# BLOG_DB_STATEMENT_TIMEOUT_MS=0
# BLOG_DB_LOCK_TIMEOUT_MS=0
# BLOG_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=0
# BLOG_DB_CONNECT_RETRIES=3
# BLOG_DB_CONNECT_RETRY_BACKOFF_MS=250
# 查询/锁/事务空闲超时为 0 时沿用数据库角色或 DSN 设置。
# 生产 HTTP 可设置 BLOG_DB_STATEMENT_TIMEOUT_MS=30000、BLOG_DB_LOCK_TIMEOUT_MS=5000、
# BLOG_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000；迁移/维护可使用独立命令环境。
